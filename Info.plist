<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Exercise Analyzer saves your trimmed swing clips to Photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>With End when I leave on, the watch ends your workout once you leave the place you started it.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Exercise Analyzer reads your heart rate during a workout started on the watch.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Exercise Analyzer saves each workout you end on the watch to Health, with its sets.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- The commit a bug report names (BugKit); `just build-*` pass BUGKIT_COMMIT, an Xcode build leaves it "unknown". -->
	<key>BugKitCommit</key>
	<string>$(BUGKIT_COMMIT)</string>
	<!-- The repository the About / version screen links the commit into (BugKit 0.3.3, bug-kit #45). -->
	<key>BugKitRepositoryURL</key>
	<string>https://github.com/idvorkin/exercise-analyzer</string>
	<!-- Story 069: exerciseanalyzer:// brings the app forward from another app (Grabber Native's home screen). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.idvorkin.exerciseanalyzer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>exerciseanalyzer</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
